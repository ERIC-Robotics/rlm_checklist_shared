# Email settings for ticket notifications, trial PDFs, and registration notices.
# Copy this file to .env.local and fill in real values.

# Neon PostgreSQL connection string. Create a database at https://console.neon.tech/
# and copy its pooled connection string here (keep credentials private).
DATABASE_URL=

# Random secret used to sign secure employee login sessions (minimum 32 characters).
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Encryption key for Aadhaar values stored in PostgreSQL.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret stable and separate from AUTH_SECRET.
AADHAAR_ENCRYPTION_KEY=dtHHPrXC852yYgUvVwIbI9fp4Px3iRFlap+uAwbaVoY=


# Microsoft 365: use Graph OAuth below. When Graph credentials are present,
# Graph is used instead of SMTP. Register an app in Microsoft Entra and grant
# Microsoft Graph application permission Mail.Send with admin consent.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the app is allowed to send from. Defaults to MAIL_FROM if blank.
MS_GRAPH_FROM_EMAIL=reports@ericrobotics.com

# SMTP fallback for providers that support SMTP password or OAuth credentials.
SMTP_HOST=smtp.office365.com

# 587 for STARTTLS (most common), 465 for implicit TLS
SMTP_PORT=587

# true for port 465, false for port 587 (defaults based on SMTP_PORT if omitted)
SMTP_SECURE=false

# Login credentials for the SMTP account.
# For Gmail: create an "App Password" — your normal Google password will NOT work.
SMTP_USER=reports@ericrobotics.com
SMTP_PASS=

# Address the email appears to come from (usually same as SMTP_USER)
MAIL_FROM=reports@ericrobotics.com

# Email destinations (optional; leave blank to disable email notifications).
MAIL_TO=reports@ericrobotics.com
TEAM_LEAD_EMAILS=reports@ericrobotics.com
HARDWARE_LEAD_EMAIL=sarthak.gupta@ericrobotics.com,shreyas.shinde@ericrobotics.com
SOFTWARE_LEAD_EMAIL=kunal.awari@ericrobotics.com,pratik.software@ericrobotics.com

# Employee-registration approval links are sent to both approvers in lib/mailer.js.

# Public app URL used to build one-time manager approval links in registration emails.
# Example: https://rlm-checklist.example.workers.dev
APP_BASE_URL=
